# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Google OAuth 2.0 (Google Cloud Console -> APIs & Credentials) -------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Optional: pin a specific Business Profile location (bare location ID or
# accounts/{account}/locations/{location}). Leave empty to auto-resolve the
# first location of the first My Business account.
GOOGLE_LOCATION_ID=

# --- Groq (https://console.groq.com/keys) ---------------------------------
GROQ_API_KEY=gsk_your-groq-api-key

# Optional: Groq model used for reply generation.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (https://aistudio.google.com/apikey) --------------------------
# Backup provider: used only when Groq fails (or GROQ_API_KEY is empty),
# both for reply generation and for the manual "Check Reply" validation.
# At least one of GROQ_API_KEY / GEMINI_API_KEY must be set.
GEMINI_API_KEY=

# Optional: Gemini model used for fallback generation and reply checks.
GEMINI_MODEL=gemini-3.8-flash

# --- Frontend / CORS ------------------------------------------------------
# Comma-separated browser origins allowed to call this API. Defaults cover the
# local Vite dev server (5173) and preview server (4173). Set this to your
# deployed frontend origin(s) in production.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Base URL of the frontend. After Google sign-in, the OAuth callback redirects
# the browser here (e.g. https://your-site.netlify.app in production). Leave
# empty for API-only use: the callback then answers JSON.
FRONTEND_URL=http://localhost:5173

# --- Google OAuth credential storage (PostgreSQL) -------------------------
# The OAuth credentials are stored encrypted in this database (Neon in
# production; table created automatically). Use a separate Neon branch or a
# local PostgreSQL for development: authorizing locally against the
# production database replaces the production credentials.
DATABASE_URL=
# Fernet key encrypting the stored credentials. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes stored credentials unreadable; to rotate use "new,old".
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Legacy token file: no longer read or written at runtime. Only the default
# source of `python -m app.auth.import_token` (one-time migration).
GOOGLE_TOKEN_FILE=

# --- Automatic review replies (Pub/Sub webhook) -----------------------------
# Master switch. false = new-review events are received and logged only;
# nothing is generated and NOTHING is ever published automatically.
AUTO_REPLY_ENABLED=false
# true = run the full pipeline (generate, validate, final Google check) but
# never publish; the reply is logged as WOULD_PUBLISH.
AUTO_REPLY_DRY_RUN=false
# Validation-triggered regenerations per review: 0 or 1 (hard maximum 1).
AUTO_REPLY_MAX_REGENERATIONS=1
# Optional comma-separated location ids to automate. Empty = all locations
# of the account whose notification setting points at the Pub/Sub topic.
AUTO_REPLY_LOCATION_IDS=

# Authenticated Pub/Sub push verification (both required for the webhook).
# Audience: the --push-auth-token-audience of the push subscription.
PUBSUB_PUSH_AUDIENCE=https://YOUR-RENDER-BACKEND-DOMAIN/webhooks/google-reviews
# Service account the push subscription signs its tokens as.
PUBSUB_PUSH_SERVICE_ACCOUNT=gbp-reviews-push@YOUR_PROJECT_ID.iam.gserviceaccount.com

# Development only: exposes POST /automation/test/{review_id}. Keep false in production.
AUTOMATION_TEST_ENDPOINT_ENABLED=false

# --- Bulk reply ("Reply to All Pending Reviews", POST /automation/backfill) ---
# Seconds to pause between reviews of a bulk reply (Groq / Google rate limits).
AUTOMATION_BACKFILL_DELAY_SECONDS=2
# Base wait before retrying a review after a transient failure (AI rate limit,
# Google 5xx); multiplied by the attempt number (15s, then 30s).
AUTOMATION_BACKFILL_RETRY_DELAY_SECONDS=15

# After a successful publish, re-read the review once to confirm Google shows
# the reply (logged as verified=True/False; never undoes PUBLISHED).
AUTO_REPLY_VERIFY_AFTER_PUBLISH=true

# --- Reconciliation (safety net for delayed / missed Pub/Sub notifications) ---
# POST /automation/reconcile, called by an external scheduler (Cloud Scheduler,
# cron-job.org, GitHub Actions, a Render Cron Job). Processes recent
# unanswered reviews through the same pipeline as the webhook.
RECONCILIATION_ENABLED=true
# Shared secret the scheduler sends as "Authorization: Bearer <secret>" or
# "X-Reconcile-Secret: <secret>". Required (16+ characters); the endpoint is
# closed while empty. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RECONCILIATION_SECRET=
# Reviews processed per reconciliation run (newest first, 1-100).
RECONCILIATION_MAX_REVIEWS=10
# Only reviews created/updated within this many minutes are candidates (also
# used by the webhook's fallback resolution). 0 = no limit. Default 7 days.
RECONCILIATION_LOOKBACK_MINUTES=10080
